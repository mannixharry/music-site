{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artist-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true
  },

  // frankkirwan.com is attached to this Worker through the dashboard, not here.
  //
  // Both of these are security settings, not tidiness. Cloudflare Access is
  // configured against frankkirwan.com/admin — it is NOT in front of
  // artist-site.<subdomain>.workers.dev or a preview URL. Leaving either
  // enabled publishes the admin API on a hostname nothing is guarding.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Assets are matched first and served without invoking the Worker, which is
    // why the site costs nothing to serve. This carves out the one prefix that
    // must reach the Worker instead — otherwise the SPA fallback would answer
    // /api/content with index.html.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artist-site",
      // Only used for --remote; local development ignores it entirely.
      "database_id": "4af3cccf-2483-45d3-8f6c-7e06a89cdbfc"
    }
  ],

  "r2_buckets": [
    // Two buckets, because an R2 custom domain exposes a WHOLE bucket — there
    // is no per-prefix access control. Masters kept under a prefix in the
    // public bucket would be downloadable by anyone who guessed a song's slug.
    { "binding": "MEDIA", "bucket_name": "frank-kirwan-media" },
    { "binding": "MASTERS", "bucket_name": "frank-kirwan-masters" }
  ],

  "vars": {
    "MEDIA_BASE": "https://media.frankkirwan.com",
    // Repeated from r2_buckets above because presigning builds an S3 URL by
    // hand and bindings do not expose the bucket name they point at.
    "MEDIA_BUCKET": "frank-kirwan-media",
    "MASTERS_BUCKET": "frank-kirwan-masters",
    // Checked after Access has already vetted the request — the Access policy
    // is the gate, this is a second opinion that survives a mis-edited policy.
    // Both of Harry's addresses are here because the Cloudflare account is the
    // icloud one while the Access policy names the gmail one; whichever he
    // signs in with has to appear in both places or the request dies here,
    // after a login that looked like it worked.
    "ADMIN_EMAILS": "mannixharry@gmail.com,harrymannix@icloud.com",
    "ACCESS_TEAM": "frankkirwan",
    // ONE Access application covers both frankkirwan.com/admin and
    // frankkirwan.com/api/admin, so there is one audience tag here.
    //
    // It was two, and that was a bug. Each application keeps its own session,
    // and an Access session can only be established by a NAVIGATION — an
    // unauthenticated request is answered with a 302 to the login page on
    // <team>.cloudflareaccess.com, and a fetch that follows a redirect to
    // another origin is killed by CORS. Nothing ever navigates to /api/admin,
    // so that application's session was never renewed, and the admin died with
    // an unexplained "Failed to fetch" the moment it lapsed. One application
    // means the login that loads the page also authorises the page's requests.
    //
    // Still parsed as a list, so a token minted for any other application in
    // the organisation is refused. "One of these", not "any".
    "ACCESS_AUD": "55928689a653e51d6545f4fb5865f2547091928eb79018d83ac34ccbe01f6802"
  }

  // Secrets, set with `wrangler secret put` and never written in this file:
  //   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ACCOUNT_ID
}
