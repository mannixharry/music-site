{
  "name": "artist-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "prebuild": "node scripts/pull-snapshot.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply artist-site --local",
    "db:migrate": "wrangler d1 migrations apply artist-site --remote",
    "db:seed:local": "node scripts/seed-d1.mjs",
    "db:seed": "node scripts/seed-d1.mjs --remote",
    "db:dump": "mkdir -p backup && wrangler d1 export artist-site --remote --output backup/d1-dump.sql"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.11.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "music-metadata": "^11.14.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wrangler": "^4.114.0"
  }
}
